{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "lattice": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api/index.py",
      "installCommand": "pip install -r requirements.txt",
      "buildCommand": "echo 'Build OK'"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "lattice"
      }
    }
  ]
}
